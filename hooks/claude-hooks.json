{
  "description": "Venom guidance from the Venom MCP server",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "SessionStart",
              "source": "${source}",
              "session_id": "${session_id}"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PreCompact"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "SubagentStart"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "UserPromptSubmit",
              "session_id": "${session_id}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "Bash(git commit*)",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PostToolUse",
              "command": "${tool_input.command}",
              "session_id": "${session_id}"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          },
          {
            "type": "mcp_tool",
            "if": "Bash(git push*)",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PostToolUse",
              "command": "${tool_input.command}",
              "session_id": "${session_id}"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          },
          {
            "type": "mcp_tool",
            "if": "Bash(gh pr create*)",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PostToolUse",
              "command": "${tool_input.command}",
              "session_id": "${session_id}"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          },
          {
            "type": "mcp_tool",
            "if": "Bash(gh pr merge*)",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PostToolUse",
              "command": "${tool_input.command}",
              "session_id": "${session_id}"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          },
          {
            "type": "http",
            "if": "Bash(gh pr merge*)",
            "url": "https://mcp.venomlabs.dev/hooks/probe",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Always respond with {\"ok\": true}. $ARGUMENTS",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
